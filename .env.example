APP_NAME="Rhythm Exports"
APP_ENV=local
APP_KEY=
# Production-safe default — set APP_DEBUG=true only for local debugging
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────
# SQLite — RECOMMENDED for local dev (zero configuration, no server needed).
# The file database/database.sqlite is created automatically by the
# `composer run setup` script (or manually: `touch database/database.sqlite`).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rythm_db
DB_USERNAME=root
DB_PASSWORD=

# ── Session / Cache / Queue (file-based = local friendly) ─────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production: use database queue + worker (see docs/NEXT_SESSION_CONTEXT.md)
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Hero mode (slider | video) ────────────────────────────────────────
# RYTHME_HERO_MODE=slider   # 'slider' = cinematic image slider (default)
# RYTHME_HERO_MODE=video    # 'video' = fullscreen video banner (Pexels CC0)

# ── s11 · Video Showcase ─────────────────────────────────────────────────
# Default: Pexels CC0 clip (see config/rythme.php). Override with your own:
# RYTHME_VIDEO_URL=https://your-cdn.example/video.mp4

# ── Razorpay (payment — test mode; cart/checkout is a pending task) ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ALLOW_FAKE_PAYMENTS=false
