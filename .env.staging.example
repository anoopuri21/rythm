# =====================================================================
#  Rhythm Exports — STAGING / DEMO .env template (Hostinger shared host)
#  Copy this file to `.env` on the server and fill the ___FILL___ values.
#  NEVER commit the real .env to git.
# =====================================================================

APP_NAME="Rhythm Exports"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Aapka domain, https ke saath, end me slash nahi
APP_URL=https://___FILL_YOUR_DOMAIN___

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (Hostinger hPanel -> Databases -> MySQL) ---------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=___FILL_DB_NAME___
DB_USERNAME=___FILL_DB_USER___
DB_PASSWORD=___FILL_DB_PASSWORD___

# --- Session / cache / queue ----------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# --- Mail (staging: log driver = koi asli email nahi jayegi) ---------
# Asli emails bhejni ho to MAIL_MAILER=smtp karke Hostinger ke SMTP details bharo
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@___FILL_YOUR_DOMAIN___"
MAIL_FROM_NAME="${APP_NAME}"

# --- Razorpay (STAGING = TEST keys only; rzp_test_... se shuru hote hain) ---
RAZORPAY_KEY_ID=___FILL_RZP_TEST_KEY_ID___
RAZORPAY_KEY_SECRET=___FILL_RZP_TEST_SECRET___
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ALLOW_FAKE_PAYMENTS=false

# --- Homepage top-bar contact/social (blank = hidden) ---------------
RYTHME_CONTACT_PHONE=
RYTHME_CONTACT_EMAIL=
RYTHME_SOCIAL_INSTAGRAM=
RYTHME_SOCIAL_FACEBOOK=
RYTHME_SOCIAL_YOUTUBE=

VITE_APP_NAME="${APP_NAME}"
