# ============================================================
#  FALLBACK ONLY — sirf tab use karo jab symlink method fail ho.
#  Ye file public_html/.htaccess ke naam se rakhni hai.
#  Kya karti hai: har request ko chupchap Laravel ke public/ folder me bhej deti hai.
#  Guide: docs/DEPLOY_HOSTINGER.md -> "Plan B"
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sensitive files ko web se block karo
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan) - [F,L]

    # Agar file public/ me exist karti hai to wahi serve karo
    RewriteCond %{DOCUMENT_ROOT}/../app/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/../app/public/$1 -d
    RewriteRule ^(.*)$ /../app/public/$1 [L]

    # Baaki sab Laravel ke front controller pe
    RewriteRule ^ /../app/public/index.php [L]
</IfModule>

<Files .env>
    Require all denied
</Files>
